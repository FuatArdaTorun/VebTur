# Copy this file to .env and fill in real local development values.
# .env is gitignored and must never be committed.

# PostgreSQL (Docker)
POSTGRES_DB=vebtur
POSTGRES_USER=vebtur_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Full Docker stack (docker compose up -d --build)
# Any random string of at least 32 characters, e.g. the output of `openssl rand -base64 48`.
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-characters
# Admin account created on first start. The password needs an uppercase letter, a lowercase
# letter and a number, at least 8 characters.
ADMIN_EMAIL=admin@vebtur.local
ADMIN_PASSWORD=ChangeMe123
WEB_PORT=8080
